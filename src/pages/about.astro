---
import { Font } from 'astro:assets';
import AboutDesk from '../components/AboutDesk.astro';
import AboutText from '../components/AboutText.astro';
import { labels, profile } from '../data/about';
import '../styles/about.css';

const year = new Date().getFullYear();
const canonicalURL = new URL('about/', Astro.site);
---

<!doctype html>
<html lang="zh-Hant" data-language="zh" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			(() => {
				const root = document.documentElement;
				let theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				let language = 'zh';
				try {
					const savedTheme = localStorage.getItem('about-theme');
					if (savedTheme === 'light' || savedTheme === 'dark') theme = savedTheme;
					if (localStorage.getItem('about-language') === 'en') language = 'en';
				} catch {}
				const requestedLanguage = new URLSearchParams(location.search).get('lang');
				if (requestedLanguage === 'zh' || requestedLanguage === 'en') language = requestedLanguage;
				root.dataset.theme = theme;
				root.dataset.language = language;
				root.lang = language === 'en' ? 'en' : 'zh-Hant';
				root.dataset.enhanced = 'true';
			})();
		</script>
		<title>{profile.title.zh} · {profile.name}</title>
		<meta name="description" content={profile.description.zh} data-zh={profile.description.zh} data-en={profile.description.en} />
		<meta name="theme-color" content="#f4f1ea" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/svg+xml" href="/about-mark.svg" />
		<meta property="og:type" content="profile" />
		<meta property="og:title" content={`${profile.title.zh} · ${profile.name}`} data-zh={`${profile.title.zh} · ${profile.name}`} data-en={`${profile.title.en} · ${profile.name}`} />
		<meta property="og:description" content={profile.description.zh} data-zh={profile.description.zh} data-en={profile.description.en} />
		<meta property="og:url" content={canonicalURL} />
		<Font cssVariable="--font-atkinson" preload />
	</head>
	<body class="about-page">
		<a class="skip-link" href="#main"><AboutText text={labels.skip} /></a>
		<header class="site-header">
			<nav class="navigation" aria-label="Main navigation / 主選單">
				<a class="wordmark" href="/" aria-label={`${profile.name} — Home`}>
					<svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M14 3v22M3 14h22M6.2 6.2l15.6 15.6M6.2 21.8 21.8 6.2" stroke="currentColor" stroke-width="3.8" stroke-linecap="round" /></svg>
					<span>{profile.name}<span class="wordmark-dot">.</span></span>
				</a>
				<div class="nav-links">
					<a class="nav-link current" href="/about/" aria-current="page"><AboutText text={labels.about} /></a>
					<a class="nav-link" href="/blog/"><AboutText text={labels.notes} /></a>
				</div>
				<div class="preferences js-controls">
					<div class="language-switch" role="group" aria-label="Language / 語言">
						<button type="button" data-set-language="zh" lang="zh-Hant" aria-label="繁體中文" aria-pressed="true">中</button>
						<button type="button" data-set-language="en" lang="en" aria-label="English" aria-pressed="false">EN</button>
					</div>
					<button class="theme-toggle" type="button" aria-label="切換至深色模式" title="切換至深色模式">
						<svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" /></svg>
						<svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4" /></svg>
					</button>
				</div>
			</nav>
		</header>

		<main id="main" class="about-main">
			<div class="hero-art"><AboutDesk /><span class="art-caption" lang="en">A SPACE TO THINK, BUILD & GROW</span></div>
			<div class="greeting"><span class="greeting-star" aria-hidden="true">✳</span><AboutText text={profile.greeting} /></div>
			<section class="profile-heading" aria-labelledby="profile-name">
				<div><p class="eyebrow" lang="en">ABOUT ME</p><h1 id="profile-name">{profile.name}<span class="name-dot">.</span></h1><p class="tagline"><AboutText text={profile.tagline} /></p></div>
				<div class="monogram" aria-hidden="true"><span>{profile.monogram}</span><svg viewBox="0 0 24 24" fill="none"><path d="m7 8-4 4 4 4m10-8 4 4-4 4m-4-10-2 12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
			</section>
			<section class="content-section intro-section" aria-labelledby="intro-heading">
				<h2 id="intro-heading"><AboutText text={labels.intro} /><span class="section-index" aria-hidden="true">01</span></h2>
				{profile.introduction.map((text) => <p><AboutText text={text} /></p>)}
				<a class="primary-link" href={profile.github} target="_blank" rel="noopener noreferrer"><AboutText text={labels.projects} /><span aria-hidden="true">↗</span></a>
			</section>
			<section class="content-section" aria-labelledby="journey-heading">
				<h2 id="journey-heading"><AboutText text={labels.journey} /><span class="section-index" aria-hidden="true">02</span></h2>
				<ol class="journey">{profile.journey.map((item) => <li><div class="journey-label">{typeof item.label === 'string' ? item.label : <AboutText text={item.label} />}</div><div class="journey-content"><h3><AboutText text={item.title} /></h3><p><AboutText text={item.text} /></p></div></li>)}</ol>
			</section>
			<section class="content-section" aria-labelledby="interests-heading">
				<h2 id="interests-heading"><AboutText text={labels.interests} /><span class="section-index" aria-hidden="true">03</span></h2>
				<ul class="interests">{profile.interests.map((text) => <li><span aria-hidden="true">✦</span><AboutText text={text} /></li>)}</ul>
			</section>
			<section class="content-section explore-section" aria-labelledby="explore-heading">
				<h2 id="explore-heading"><AboutText text={labels.explore} /><span class="section-index" aria-hidden="true">04</span></h2>
				<div class="explore-grid">
					<a class="explore-card project-card" href={`${profile.github}?tab=repositories`} target="_blank" rel="noopener noreferrer"><div class="card-top"><span class="card-icon" aria-hidden="true">〈/〉</span><span class="card-arrow" aria-hidden="true">↗</span></div><h3><AboutText text={labels.projectTitle} /></h3><p><AboutText text={labels.projectText} /></p><span class="card-label" lang="en">GITHUB</span></a>
					<a class="explore-card notes-card" href="/blog/"><div class="card-top"><svg class="notebook-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="7" y="4" width="20" height="24" rx="3" /><path d="M12 4v24M4 10h5m-5 6h5m-5 6h5m8-11h7m-7 5h5" /></svg><span class="card-arrow" aria-hidden="true">↗</span></div><h3><AboutText text={labels.noteTitle} /></h3><p><AboutText text={labels.noteText} /></p><span class="card-label" lang="en">FIELD NOTES</span></a>
				</div>
			</section>
			<section class="connect-section" aria-labelledby="connect-heading">
				<div><span class="eyebrow" lang="en">SAY HELLO</span><h2 id="connect-heading"><AboutText text={labels.connect} /></h2></div>
				<a class="github-link" href={profile.github} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.58 9.58 0 0 1 12 6.82c.85 0 1.7.11 2.5.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg><span>GitHub</span><span aria-hidden="true">↗</span></a>
			</section>
		</main>
		<footer class="about-footer"><p>© {year} {profile.name}</p><p><AboutText text={labels.footer} /></p></footer>
		<script>
			const root = document.documentElement;
			const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
			const languageButtons = document.querySelectorAll<HTMLButtonElement>('[data-set-language]');
			const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
			const savePreference = (key: string, value: string) => { try { localStorage.setItem(key, value); } catch {} };
			function updateControls() {
				const english = root.dataset.language === 'en';
				const dark = root.dataset.theme === 'dark';
				const themeLabel = english ? `Switch to ${dark ? 'light' : 'dark'} mode` : `切換至${dark ? '淺' : '深'}色模式`;
				themeButton?.setAttribute('aria-label', themeLabel);
				themeButton?.setAttribute('title', themeLabel);
				languageButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.setLanguage === root.dataset.language)));
				if (themeColor) themeColor.content = dark ? '#222724' : '#f4f1ea';
				document.querySelectorAll<HTMLMetaElement>('meta[data-zh][data-en]').forEach((meta) => { meta.content = (english ? meta.dataset.en : meta.dataset.zh) || ''; });
				const title = document.querySelector<HTMLMetaElement>('meta[property="og:title"]');
				if (title) document.title = title.content;
			}
			languageButtons.forEach((button) => button.addEventListener('click', () => {
				const language = button.dataset.setLanguage === 'en' ? 'en' : 'zh';
				root.dataset.language = language;
				root.lang = language === 'en' ? 'en' : 'zh-Hant';
				savePreference('about-language', language);
				const url = new URL(location.href);
				url.searchParams.set('lang', language);
				history.replaceState(null, '', url);
				updateControls();
			}));
			themeButton?.addEventListener('click', () => {
				root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
				savePreference('about-theme', root.dataset.theme);
				updateControls();
			});
			updateControls();
		</script>
	</body>
</html>
