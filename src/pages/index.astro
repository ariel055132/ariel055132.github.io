---
import AboutDesk from '../components/AboutDesk.astro';
import AboutText from '../components/AboutText.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import { personalWebsite } from '../data/projects';
import { profile } from '../data/about';
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/home.css';
---

<SiteLayout
	title={{ zh: '保持好奇，把想法做出來', en: 'Stay curious. Make ideas real.' }}
	description={profile.description}
	mainClass="home-main"
>
	<section class="home-hero" aria-labelledby="home-heading">
		<div class="home-hero-copy">
			<p class="home-eyebrow">A LITTLE CORNER OF THE INTERNET</p>
			<p class="home-hello"><AboutText text={{ zh: `嗨，我是 ${profile.name}`, en: `Hello, I’m ${profile.name}` }} /><span aria-hidden="true"> ✳</span></p>
			<h1 id="home-heading">
				<span class="home-heading-line"><AboutText text={{ zh: '保持好奇，', en: 'Stay curious.' }} /></span>
				<span class="home-heading-line home-heading-accent"><AboutText text={{ zh: '把想法做出來。', en: 'Make ideas real.' }} /></span>
			</h1>
			<p class="home-lead"><AboutText text={{ zh: '用 side projects 探索好奇的事，\n用文字留下實作與學習的過程。', en: 'Exploring through side projects, and keeping notes on what I build and learn along the way.' }} /></p>
			<div class="home-actions">
				<a class="home-button" href="/about/"><AboutText text={{ zh: '多認識我一點', en: 'A little about me' }} /><span aria-hidden="true">→</span></a>
				<a class="home-text-link" href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>
			</div>
		</div>
		<figure class="home-hero-art">
			<AboutDesk />
			<figcaption><span class="home-art-line" aria-hidden="true"></span>BUILD · LEARN · REPEAT</figcaption>
		</figure>
	</section>

	<div class="home-intro-line">
		<p><span class="home-status-dot" aria-hidden="true"></span><AboutText text={{ zh: '一個持續成長的小地方', en: 'A small space, always growing' }} /></p>
		<p><AboutText text={{ zh: '從一個小問題開始，一點一點改進。', en: 'Start small. Keep making things better.' }} /></p>
	</div>

	<section class="home-section" aria-labelledby="home-projects-heading">
		<div class="home-section-heading">
			<h2 id="home-projects-heading"><span class="home-section-number" aria-hidden="true">01</span><AboutText text={{ zh: '正在做的事', en: 'What I’m building' }} /></h2>
			<a class="home-text-link" href="/projects/"><AboutText text={{ zh: '所有作品', en: 'All projects' }} /><span aria-hidden="true">→</span></a>
		</div>
		<div class="home-project">
			<ProjectVisual project={personalWebsite} />
			<div class="home-project-copy">
				<p class="home-project-type"><AboutText text={personalWebsite.category} /> · <AboutText text={personalWebsite.status} /></p>
				<h3><AboutText text={personalWebsite.title} /></h3>
				<p class="home-project-description"><AboutText text={personalWebsite.summary} /></p>
				<ul class="home-project-tags" aria-label="Technologies">{personalWebsite.technologies.map((technology) => <li>{technology}</li>)}</ul>
				<a class="home-text-link home-project-link" href={`/projects/${personalWebsite.slug}/`}><AboutText text={{ zh: '看看這個案例', en: 'Explore the case study' }} /><span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>

	<section class="home-section home-notes-section" aria-labelledby="home-notes-heading">
		<div class="home-section-heading">
			<h2 id="home-notes-heading"><span class="home-section-number" aria-hidden="true">02</span><AboutText text={{ zh: '開發筆記', en: 'Notes along the way' }} /></h2>
			<span class="home-section-label">LEARNING IN THE OPEN</span>
		</div>
		<div class="home-notes">
			<div class="home-notebook" aria-hidden="true"><svg viewBox="0 0 72 80" fill="none" focusable="false"><path d="M19 11H56C59 11 61 13 61 16V63C61 66 59 68 56 68H19C15 68 12 65 12 61V18C12 14 15 11 19 11Z" fill="currentColor" opacity=".1"/><path d="M19 11H55C58 11 60 13 60 16V64H19C15 64 12 67 12 62V18C12 14 15 11 19 11Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M21 11V64M31 27H49M31 34H49M31 41H42M17 68H60M48 11V22L44 19L40 22V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
			<div class="home-notes-copy">
				<h3><AboutText text={{ zh: '把過程也留下來。', en: 'Keep the process, too.' }} /></h3>
				<p><AboutText text={{ zh: '做了什麼、為什麼這樣做，還有途中學到的小事。', en: 'What I made, why I made it that way, and the little things learned in between.' }} /></p>
				<p class="home-notes-status"><AboutText text={{ zh: '個人筆記整理中，目前可以先看看示範文章。', en: 'Personal notes are on the way. Sample articles are available for now.' }} /></p>
			</div>
			<a class="home-text-link home-notes-link" href="/blog/"><AboutText text={{ zh: '逛逛筆記', en: 'Browse notes' }} /><span aria-hidden="true">→</span></a>
		</div>
	</section>
</SiteLayout>
