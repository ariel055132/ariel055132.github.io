---
import AboutText from './AboutText.astro';
import SiteControls from './SiteControls.astro';
import { profile } from '../data/about';

const navigation = [
    { href: '/', label: { zh: '首頁', en: 'Home' } },
    { href: '/about/', label: { zh: '關於我', en: 'About' } },
    { href: '/blog/', label: { zh: '筆記', en: 'Notes' } },
];
const path = `${Astro.url.pathname.replace(/\/$/, '')}/`;
const isCurrent = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<header class="site-header">
	<nav class="navigation" aria-label="Main navigation / 主選單">
		<a class="wordmark" href="/" aria-label={`${profile.name} — Home`}>
			<svg viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M14 3v22M3 14h22M6.2 6.2l15.6 15.6M6.2 21.8 21.8 6.2" stroke="currentColor" stroke-width="3.8" stroke-linecap="round" /></svg>
			<span>{profile.name}<span class="wordmark-dot">.</span></span>
		</a>
		<div class="nav-links">
                        {navigation.map((item) => (
                            <a class:list={['nav-link', { current: isCurrent(item.href) }]} href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                                <AboutText text={item.label} />
                            </a>
                        ))}
                    </div>
		<SiteControls />
            </nav>
</header>
