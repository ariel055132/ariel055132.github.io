---
import AboutText from './AboutText.astro';
import { labels, profile } from '../data/about';
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="footer-inner">
        <div>
            <p class="footer-signature">© {year} {profile.name}<span aria-hidden="true"> ✳</span></p>
            <p class="footer-note"><AboutText text={labels.footer} /></p>
        </div>
        <nav class="footer-links" aria-label="Footer / 頁尾">
            <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
            <a href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
        </nav>
    </div>
</footer>
