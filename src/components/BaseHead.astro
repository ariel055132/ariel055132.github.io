---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import type { AboutCopy } from '../data/about';
import { Font } from 'astro:assets';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_DESCRIPTION_EN } from '../consts';

interface Props {
    title?: string | AboutCopy;
    description?: string | AboutCopy;
    image?: ImageMetadata | string;
    type?: 'website' | 'article' | 'profile';
    publishedTime?: Date;
    modifiedTime?: Date;
}

const {
    title,
    description = { zh: SITE_DESCRIPTION, en: SITE_DESCRIPTION_EN },
    image = '/site-preview.png',
    type = 'website',
    publishedTime,
    modifiedTime,
} = Astro.props;
const copy = (value: string | AboutCopy): AboutCopy => typeof value === 'string' ? { zh: value, en: value } : value;
const pageTitle = title ? copy(title) : { zh: SITE_TITLE, en: SITE_TITLE };
const fullTitle = {
    zh: pageTitle.zh === SITE_TITLE ? SITE_TITLE : `${pageTitle.zh} · ${SITE_TITLE}`,
    en: pageTitle.en === SITE_TITLE ? SITE_TITLE : `${pageTitle.en} · ${SITE_TITLE}`,
};
const pageDescription = copy(description);
const canonicalURL = new URL(`${Astro.url.pathname.replace(/\/$/, '')}/`, Astro.site);
const imageURL = new URL(typeof image === 'string' ? image : image.src, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<script is:inline>
    (() => {
        const root = document.documentElement;
        let theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        let language = 'zh';
        try {
            const savedTheme = localStorage.getItem('site-theme') || localStorage.getItem('about-theme');
            if (savedTheme === 'light' || savedTheme === 'dark') theme = savedTheme;
            const savedLanguage = localStorage.getItem('site-language') || localStorage.getItem('about-language');
            if (savedLanguage === 'en') language = 'en';
        } catch {}
        const requestedLanguage = new URLSearchParams(location.search).get('lang');
        if (requestedLanguage === 'zh' || requestedLanguage === 'en') {
            language = requestedLanguage;
            try { localStorage.setItem('site-language', language); } catch {}
        }
        root.dataset.theme = theme;
        root.dataset.language = language;
        root.lang = language === 'en' ? 'en' : 'zh-Hant';
        root.dataset.enhanced = 'true';
    })();
</script>
<link rel="icon" type="image/svg+xml" href="/about-mark.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} · Notes`} href={new URL('rss.xml', Astro.site)} />
<link rel="canonical" href={canonicalURL} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#f4f1ea" />
<Font cssVariable="--font-atkinson" preload />
<title>{fullTitle.zh}</title>
<meta name="description" content={pageDescription.zh} data-zh={pageDescription.zh} data-en={pageDescription.en} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle.zh} data-zh={fullTitle.zh} data-en={fullTitle.en} />
<meta property="og:description" content={pageDescription.zh} data-zh={pageDescription.zh} data-en={pageDescription.en} />
<meta property="og:image" content={imageURL} />
<meta name="twitter:card" content="summary_large_image" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
